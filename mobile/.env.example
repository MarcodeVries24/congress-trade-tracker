# Copy to .env.local. Expo inlines every EXPO_PUBLIC_ variable into the bundle
# at build time, so nothing secret may go in here.

# From the Clerk dashboard, API keys.
#
# Use the DEVELOPMENT instance key (pk_test_...) locally. A production key is
# locked to congtrade.com and refuses any other origin, which on the Expo web
# target shows up as "Production Keys are only allowed for domain" followed by
# a retry loop that React reports as "Maximum update depth exceeded". Native
# builds are not origin-checked, so a production key is correct there and
# belongs in the EAS build profile rather than in this file.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Where the app reads trades from. The API sends no CORS headers, so the Expo
# web target cannot reach the production origin from localhost; native builds
# are unaffected. Point this at a local Next.js dev server to work against
# unreleased API changes.
EXPO_PUBLIC_API_BASE=https://www.congtrade.com
