# Every variable the site reads, and where it comes from. Copy to
# .env.local for development; set the same names in Vercel for production.
# Values here are placeholders — never commit a real key.

# --- Database -----------------------------------------------------------
# Neon Postgres. The same database the ingest workspace writes to.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Clerk (accounts) ---------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# From the Clerk dashboard webhook that points at /api/webhooks/clerk.
# Without it that route refuses every delivery, which is what caps the
# number of signed-in browsers on a paid account.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- Stripe (subscriptions) ---------------------------------------------
# From the standalone CongTrade Stripe account, NOT the one Clerk manages.
# Test-mode and live-mode keys, prices and webhook secrets are separate
# sets: mixing them gives "No such price" at checkout.
STRIPE_SECRET_KEY=sk_test_xxx
# The recurring prices on the CongTrade Pro product. Euros are the fallback
# and what the account settles in; the dollar pair is shown to visitors in
# the US (see lib/currency.ts) and is optional — without it everyone is
# quoted euros.
# Weekly exists for the mobile app's hard paywall and is optional: without it
# the weekly option simply isn't offered, rather than falling back to a price
# the buyer didn't pick.
STRIPE_PRICE_WEEKLY=price_xxx
STRIPE_PRICE_WEEKLY_USD=price_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx
STRIPE_PRICE_MONTHLY_USD=price_xxx
STRIPE_PRICE_ANNUAL_USD=price_xxx
# From Developers -> Webhooks, for the endpoint pointing at
# /api/webhooks/stripe. All four Stripe variables must be present or
# checkout returns 503 rather than half-working.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Off unless set to exactly "true". Stripe Tax has to be activated in the
# dashboard with an origin address first; asking for it before that fails
# every checkout session outright instead of skipping the VAT line.
STRIPE_AUTOMATIC_TAX=false

# --- Site ---------------------------------------------------------------
# Canonical origin, used for metadata, the sitemap and checkout return URLs.
# Defaults to https://www.congtrade.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ads (optional) -----------------------------------------------------
# Unset until AdSense approves the site. The account-level script in
# layout.tsx only renders when the client id is present.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# --- App Store (iOS in-app purchases) -----------------------------------
# Apple's root CAs, base64 DER, comma or newline separated. Downloaded from
# apple.com/certificateauthority — the AppleRootCA-G3 is the one that signs
# App Store Server Notifications. Supplied rather than fetched, because a
# verifier that downloads its own trust anchors can be talked out of them.
APPLE_ROOT_CERTS=
# From App Store Connect -> Users and Access -> Integrations -> In-App Purchase.
APPLE_ISSUER_ID=
# "sandbox" while testing with a sandbox tester account, anything else is
# treated as production. Notifications are signed the same either way; this
# decides which environment the payload is checked against.
APPLE_ENVIRONMENT=production

# --- Google Play (Android in-app purchases) -----------------------------
# The whole service account JSON on one line. Play Console -> Setup -> API
# access, granted the "View financial data" and "Manage orders" permissions.
GOOGLE_SERVICE_ACCOUNT_JSON=
# A long random string. Pub/Sub push has no signature, so the endpoint is
# protected by this in the query string, which makes the URL registered in
# Pub/Sub a credential rather than an address.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
